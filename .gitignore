# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Build / packaging artifacts
dist/

# Release pipeline scratch (scripts/build-release.sh)
build/

# The signed app archive the wheel carries — 3 MB of binary, regenerated by every release build
python/drews_mac_control_mcp/resources/*.zip

# Python packaging output
python/build/
python/dist/
python/*.egg-info/

# XcodeGen output (project.yml is the source of truth — run `xcodegen generate`)
Generated/
*.xcodeproj/

# Claude Code local state (worktrees, session settings — never part of the repo)
.claude/

# macOS
.DS_Store

# Python (integration test helpers)
__pycache__/
*.pyc

# Per-build stamp, regenerated by scripts/gen-build-stamp.sh
Sources/MacControlMCPCore/BuildStamp.swift

# Per-variant identity, regenerated by scripts/gen-identity.sh (Generated/ is ignored above)
Sources/MacControlMCPCore/AppIdentity.swift
